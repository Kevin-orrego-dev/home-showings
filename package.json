{
  "name": "home-showings",
  "private": true,
  "description": "Two-sided home showing scheduler: sellers publish availability, buyers book showings that fit their own schedule.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "npm run test -w server"
  },
  "engines": {
    "node": ">=20"
  }
}
